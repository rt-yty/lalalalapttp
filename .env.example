# Используется существующая авторизация codex login. HF/API ключ не нужен.
AGENT_MODEL_BACKEND=codex
AGENT_DATA_MODE=live
AGENT_CHECKOUT_MODE=disabled
AGENT_STATE_DB=./data/agent.sqlite
# PostgreSQL вместо SQLite. Пустое значение оставляет локальную базу выше.
DATABASE_URL=
ALLOWED_HOSTS=127.0.0.1,localhost
COOKIE_SECURE=false
# Необязательно: браузерный Google Maps Embed API key с ограничением по origin.
GOOGLE_MAPS_EMBED_API_KEY=
ALLOW_LOCAL_CONFIGURATION=false
AGENT_DEFAULT_TIMEZONE=Europe/Moscow
# Модель и глубина рассуждений для всех вызовов агента.
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=low
# Необязательный альтернативный backend hf:
HF_TOKEN=
HF_MODEL_ID=
HF_INFERENCE_PROVIDER=auto
TUTU_MCP_URL=https://mcp.tutu.ru/mcp

# Необязательно: вместо ввода в интерфейсе, для запуска поиска Яндекса.
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=

# Необязательно: путь к локальной многоязычной модели Whisper.
# По умолчанию data/models/whisper/ggml-small.bin относительно папки проекта.
WHISPER_MODEL_PATH=
